{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"]
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "check": "deno check create-upload/index.ts confirm-upload/index.ts photo/index.ts repair-photo/index.ts cleanup-expired/index.ts sync-google-photos/index.ts google-photos-auth/index.ts tools/repair-storage-backends.ts integration/photo_delivery_integration_test.ts",
    "test": "deno test --allow-env tests",
    "test:integration": "deno test --allow-env --allow-net integration/photo_delivery_integration_test.ts",
    "repair:storage-backends": "deno run --allow-env --allow-net tools/repair-storage-backends.ts"
  }
}
