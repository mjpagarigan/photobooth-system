# Electron main process OS/service environment only. The app does not parse a
# project .env file, and these values are never exposed to the renderer.
# webcam (default) uses the laptop or system camera, mock uses bundled fixtures,
# and sony stays gated behind docs/SONY_CAMERA_INTEGRATION.md.
GRACE_BOOTH_CAMERA_ADAPTER=webcam
GRACE_BOOTH_SUPABASE_URL=https://your-project.supabase.co
GRACE_BOOTH_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Public Cloudflare Pages app. These values are safe for browser use; the
# public page never receives a Supabase secret key or booth credential.
VITE_PUBLIC_PHOTO_API_URL=https://your-project.supabase.co/functions/v1/photo
VITE_PUBLIC_PAGE_ORIGIN=https://photos.example.org
VITE_PUBLIC_R2_ORIGIN=https://your-bucket.your-account-id.r2.cloudflarestorage.com

# Supabase Edge Functions. Configure hosted values through Supabase secrets.
# SUPABASE_URL is platform-provided when hosted; the explicit server key below
# is for the ignored supabase/.env.local file used by local Function serving.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
PUBLIC_TOKEN_DERIVATION_KEY=REPLACE_ME
PUBLIC_PAGE_ORIGIN=https://photos.example.org
PHOTO_BUCKET=photos
CLEANUP_SECRET=REPLACE_WITH_RANDOM_SECRET
