{
  "name": "@grace-booth/kiosk",
  "version": "0.1.0",
  "private": true,
  "description": "Secure offline-first Grace Booth Electron kiosk",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "dist:win": "pnpm build && electron-builder --config electron-builder.yml --win nsis --x64 && pnpm native:self-test:packaged",
    "native:self-test": "pnpm build && tsx scripts/native-self-test.ts",
    "native:self-test:packaged": "tsx scripts/native-self-test.ts --packaged",
    "startup:smoke:packaged": "tsx scripts/packaged-startup-smoke.ts",
    "resources:generate": "node scripts/generate-resources.mjs",
    "frames:prepare": "node scripts/prepare-anniversary-frames.mjs",
    "frame:build": "node scripts/build-default-frame.mjs",
    "frame:verify": "node scripts/verify-default-frame.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@grace-booth/shared": "workspace:*",
    "@grace-booth/ui": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.112.3",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.0",
    "lottie-react": "3.1.0",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-rnd": "10.5.3",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "catalog:",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "drizzle-kit": "0.31.10",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "happy-dom": "20.11.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "build": {
    "extends": null
  }
}
